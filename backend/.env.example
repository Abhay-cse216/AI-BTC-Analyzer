# Copy this file to ".env" in the same folder and adjust values as needed.
# Never commit the real ".env" file.

# --- App ---
APP_NAME=AI-BTC Analyzer
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated, no spaces around commas needed) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Mempool.space API (public, no key required) ---
MEMPOOL_API_BASE_URL=https://mempool.space/api
MEMPOOL_WS_URL=wss://mempool.space/api/v1/ws
MEMPOOL_REQUEST_TIMEOUT_SECONDS=10

# --- PostgreSQL ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_btc_analyzer

# --- Caching ---
CACHE_TTL_SECONDS=30
